{
  "description": "prose injection hooks: load conversation at session start and restate its checklist on every turn. A copy under ~/.claude/skills/ takes priority over the plugin's own.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject.js\" conversation SKILL.md",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/inject.js\" conversation checks.md",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
